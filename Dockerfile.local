# syntax=docker/dockerfile:1.7
# =============================================================================
# LOCAL runtime image — packages a HOST-built Spring Boot bootJar.
#
# Unlike the per-service multi-stage Dockerfiles (which build inside the
# container and need the shared libraries on the classpath), this image expects
# the jar to be built on the host first — where Gradle resolves the onified
# shared libraries from the local Maven repo (~/.m2), no GitLab credentials
# needed. The host build stages each service's bootJar into deployment/jars/.
#
# Build context MUST be the monorepo root. Driven by deployment/docker-compose.localjar.yml:
#   docker build -f deployment/Dockerfile.local \
#     --build-arg SERVICE=identity --build-arg PORT=8082 ..
# =============================================================================
FROM eclipse-temurin:21-jre-alpine AS runtime

ARG SERVICE
ARG PORT=8080

RUN addgroup -S spring && adduser -S spring -G spring

WORKDIR /app

# Host-built bootJar, copied straight from the service's own Gradle output —
# no staging step. Run `./gradlew :services:platform:${SERVICE}:bootJar -x test
# -Ponified.useInRepoLibraries=false` on the host first.
COPY services/platform/${SERVICE}/build/libs/*.jar /app/app.jar

USER spring:spring

EXPOSE ${PORT}

# Container-aware heap: respects the compose memory limit instead of a fixed size.
ENV JAVA_OPTS="\
  -XX:+UseContainerSupport \
  -XX:MaxRAMPercentage=75.0 \
  -XX:+UseG1GC \
  -XX:MaxGCPauseMillis=200 \
  -XX:+ExitOnOutOfMemoryError \
  -XX:+HeapDumpOnOutOfMemoryError \
  -XX:HeapDumpPath=/tmp/ \
  -Djava.security.egd=file:/dev/./urandom"

ENTRYPOINT ["sh","-c","exec java $JAVA_OPTS -jar /app/app.jar"]
